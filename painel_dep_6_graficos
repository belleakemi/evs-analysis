grafico_sem_legenda <- function(caracteristica, par, testes, letra) {
  nome <- if (caracteristica == "conc") "EV concentration" else "% Small EVs"
  painel(caracteristica, par, testes) +
    labs(title = paste0(letra, ". ", nome)) +
    guides(color = "none", fill = "none", shape = "none") +
    theme(legend.position = "none")
}

faixa_comparacao <- function(titulo) {
  
  texto <- grid::textGrob(
    titulo,
    x = 0.5, y = 0.5,
    gp = grid::gpar(
      fontsize = 14,
      fontface = "bold",
      col = "black"
    )
  )
  
  fundo <- grid::roundrectGrob(
    x = 0.5, y = 0.5,
