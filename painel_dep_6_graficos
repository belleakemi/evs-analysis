# Divide cada IC em trechos exclusivos e compartilhados, SEM mudar x/y.
# O trecho compartilhado usa duas espessuras concentricas e transparencia:
# a linha de fundo continua visivel nas bordas da linha mais fina.
segmentar_ic <- function(df, par, largura_cap = 0.04) {
  saida <- list()
  adicionar <- function(i, x, xend, y, yend, sobreposto) {
    fundo <- as.character(df$trajectory[i]) == par[1]
    saida[[length(saida) + 1L]] <<- data.frame(
      trajectory = as.character(df$trajectory[i]),
      x = x, xend = xend, y = y, yend = yend,
      opacidade = if (sobreposto) { if (fundo) 0.55 else 0.70 } else 1,
      espessura = if (sobreposto) { if (fundo) 1.10 else 0.45 } else 0.60,
      ordem = if (sobreposto) { if (fundo) 1 else 2 } else 0
    )
  }
  for (i in seq_len(nrow(df))) {
    outros <- which(df$wave == df$wave[i] &
                      as.character(df$trajectory) != as.character(df$trajectory[i]) &
                      df$x == df$x[i])
    if (length(outros) > 1L) stop("Mais de um IC por grupo/tempo.")
    cortes <- c(df$lower[i], df$upper[i])
    if (length(outros) == 1L) {
      j <- outros[1]
      limites_outro <- c(df$lower[j], df$upper[j])
      cortes <- c(cortes, limites_outro[limites_outro > df$lower[i] &
                                       limites_outro < df$upper[i]])
    }
    cortes <- sort(unique(cortes))
    if (length(cortes) > 1L) {
      for (k in seq_len(length(cortes) - 1L)) {
        meio <- (cortes[k] + cortes[k + 1L]) / 2
        sobreposto <- length(outros) == 1L &&
          meio >= df$lower[outros[1]] && meio <= df$upper[outros[1]]
        adicionar(i, df$x[i], df$x[i], cortes[k], cortes[k + 1L], sobreposto)
      }
    }
    # Transparencia nas pontas horizontais apenas se coincidirem.
    for (limite in c(df$lower[i], df$upper[i])) {
      coincidente <- length(outros) == 1L &&
        limite %in% c(df$lower[outros[1]], df$upper[outros[1]])
      adicionar(i, df$x[i] - largura_cap / 2, df$x[i] + largura_cap / 2,
                limite, limite, coincidente)
    }
  }
  res <- do.call(rbind, saida)
  res[order(res$ordem), , drop = FALSE]
}

painel <- function(caracteristica, par, testes) {
  # Escala y comum entre as tres linhas para a mesma caracteristica.
  todos <- emms_plot[emms_plot$characteristic == caracteristica, ]
  df <- todos[todos$trajectory %in% par, ]
  if (any(!is.finite(c(todos$estimate, todos$lower, todos$upper)))) {
    stop("EMMs/ICs nao estimaveis; confira o ajuste do modelo.")
  }
  amplitude <- diff(range(c(todos$lower, todos$upper)))
  if (amplitude <= 0) amplitude <- max(abs(todos$estimate), 1) * 0.1
  topo <- max(todos$upper) + 0.13 * amplitude
  base <- max(0, min(todos$lower) - 0.08 * amplitude)
  limite <- topo + 0.26 * amplitude
  # Deslocamentos explicitos alinham pontos, ICs e linhas tracejadas.
  # Sem afastamento: ambos os grupos ficam exatamente em t1 e t2.
  deslocamento <- 0.0
  df$trajectory <- factor(df$trajectory, levels = par)
  df$x <- match(df$wave, wave_order) +
    ifelse(df$trajectory == par[1], -deslocamento, deslocamento)
  ic_segmentos <- segmentar_ic(df, par)
  # Transparencia somente quando o centro do ponto fica sobre o IC
  # do OUTRO grupo, no mesmo tempo e na mesma coordenada horizontal.
  # Nao alterar estimativas, limites dos ICs ou deslocamento.
  alpha_ponto_sobreposto <- 0.50  # menor = mais transparente; 1 = opaco
  df$ponto_sobre_ic <- vapply(seq_len(nrow(df)), function(i) {
    outros <- which(df$wave == df$wave[i] &
                      as.character(df$trajectory) != as.character(df$trajectory[i]) &
                      df$x == df$x[i])
    any(df$estimate[i] >= df$lower[outros] &
          df$estimate[i] <= df$upper[outros])
  }, logical(1))
  df$alpha_ponto <- ifelse(df$ponto_sobre_ic, alpha_ponto_sobreposto, 1)
  anot <- testes[testes$characteristic == caracteristica, ]
  anot$x <- ifelse(anot$context == "within_time",
                   match(anot$wave, wave_order), 1.5)
  anot$y <- topo
  anot$label <- ifelse(anot$context == "not_performed",
                       "Group post hoc not performed",
                       ifelse(anot$context == "averaged_over_time",
                              paste0(formatar_p(anot$p_adjusted), "*"),
                              formatar_p(anot$p_adjusted)))
  barras <- anot[anot$context == "within_time", , drop = FALSE]
  tit <- switch(caracteristica, size = "A. EV size",
                conc = "B. EV concentration", perc = "C. % Small EVs")
  eixo <- switch(caracteristica, size = "Estimated EV size (nm)",
                 conc = expression("Estimated concentration (" * 10^10 * " particles/mL)"),
                 perc = "Estimated % of small EVs")
  ggplot(df, aes(x, estimate, group = trajectory,
                 color = trajectory, fill = trajectory, shape = trajectory)) +
    geom_line(linewidth = 0.75, alpha = 0.70, linetype = "dashed") +
    geom_segment(
      data = ic_segmentos, inherit.aes = FALSE,
      aes(x = x, xend = xend, y = y, yend = yend,
          color = trajectory, alpha = opacidade, linewidth = espessura),
      lineend = "butt", show.legend = FALSE
    ) +
    scale_alpha_identity() +
    scale_linewidth_identity() +
    geom_point(aes(alpha = alpha_ponto),
               size = 3.8, stroke = 0.8, show.legend = FALSE) +
    geom_segment(data = barras, inherit.aes = FALSE,
                 aes(x = x - deslocamento, xend = x + deslocamento,
                     y = y, yend = y), linewidth = 0.45) +
    geom_text(
      data = anot,
      inherit.aes = FALSE,
      aes(
        x = Inf,
        y = Inf,
        label = label
      ),
      hjust = 1.10,
      vjust = 1.5,
      size = 4,
      color = "black"
    ) +
    # Manter as quatro trajetorias disponiveis para a unica legenda final.
    scale_color_manual(values = cores, limits = names(cores), drop = FALSE) +
    scale_fill_manual(values = cores, limits = names(cores), drop = FALSE) +
    scale_shape_manual(values = formas, limits = names(formas), drop = FALSE) +
    scale_x_continuous(breaks = 1:2, labels = c("t1", "t2"),
                       limits = c(0.55, 2.45)) +
    scale_y_continuous(labels = label_number(),
                       expand = expansion(mult = c(0, 0))) +
    coord_cartesian(ylim = c(base, limite)) +
    labs(title = tit, x = "Timepoint", y = eixo) + tema
}

