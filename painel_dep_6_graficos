salvar_figura <- function(figura, nome) {
  for (ext in c("pdf", "png", "tiff")) {
    argumentos <- list(filename = file.path(saida, paste0(nome, ".", ext)),
                       plot = figura, width = 10, height = 13.5,
                       units = "in", dpi = 600, bg = "white")
    if (ext == "tiff") argumentos$compression <- "lzw"
    do.call(ggsave, argumentos)
  }
}
