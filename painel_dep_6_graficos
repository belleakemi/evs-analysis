legenda_quatro_trajetorias <- function() {
  ordem <- c("Control", "Incident", "Persistent", "Remitted")
  textos <- lapply(ordem, function(nm) {
    grid::textGrob(nm, just = "left", gp = grid::gpar(fontsize = 12))
  })
  # Medidas reais dos textos para centralizar o conjunto completo.
  larguras <- lapply(textos, function(g) {
    grid::grobWidth(g) + grid::unit(0.85, "cm")
  })
  total <- Reduce(`+`, larguras)
  inicio <- (grid::unit(1, "npc") - total) / 2
  elementos <- list()
  for (i in seq_along(ordem)) {
    x_simbolo <- inicio + grid::unit(0.15, "cm")
    elementos[[length(elementos) + 1L]] <- grid::pointsGrob(
      x = x_simbolo, y = grid::unit(0.5, "npc"),
      pch = unname(formas[ordem[i]]), size = grid::unit(3.8, "mm"),
      gp = grid::gpar(col = unname(cores[ordem[i]]),
                      fill = unname(cores[ordem[i]]), lwd = 1)
    )
    elementos[[length(elementos) + 1L]] <- grid::editGrob(
      textos[[i]], x = inicio + grid::unit(0.43, "cm"),
      y = grid::unit(0.5, "npc")
    )
    inicio <- inicio + larguras[[i]]
  }
  wrap_elements(full = do.call(grid::grobTree, elementos))
}

