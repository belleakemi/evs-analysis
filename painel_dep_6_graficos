# Padroniza nomes de colunas para modelos gaussianos, Gamma e beta.
pegar_coluna <- function(tab, candidatos) {
  nome <- intersect(candidatos, names(tab))
  if (length(nome) == 0L) stop("Coluna esperada ausente: ",
                              paste(candidatos, collapse = ", "))
  tab[[nome[1L]]]
}

extrair_emm <- function(modelo, caracteristica) {
  emm <- emmeans(modelo, ~ coluna_traj | wave)
  tab <- as.data.frame(summary(emm, type = "response",
                              infer = c(TRUE, FALSE), level = 0.95,
                              adjust = "none"))
  fator <- switch(caracteristica, size = 1, conc = 1e-10, perc = 100)
  data.frame(
    characteristic = caracteristica,
    trajectory = as.character(tab$coluna_traj),
    wave = as.character(tab$wave),
    estimate = pegar_coluna(tab, c("response", "emmean", "prob")) * fator,
    lower = pegar_coluna(tab, c("lower.CL", "asymp.LCL")) * fator,
    upper = pegar_coluna(tab, c("upper.CL", "asymp.UCL")) * fator
  )
}


  emms_plot <- bind_rows(lapply(names(modelos), function(nm) {
    extrair_emm(modelos[[nm]], nm)
  }))
  write.csv(emms_plot, file.path(saida, "EMMs_para_visualizacao.csv"), row.names = FALSE)

  extrair_par_original <- function(par, nome) {
    bind_rows(lapply(names(modelos), function(nm) {
