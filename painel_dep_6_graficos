      tab <- resultado$table
      nomes <- c(paste(par, collapse = " - "), paste(rev(par), collapse = " - "))
      selecionada <- tab[as.character(tab$contrast) %in% nomes, , drop = FALSE]
      esperado <- if (resultado$context == "within_time") 2L else 1L
      if (nrow(selecionada) != esperado) stop("Contraste original ausente: ", nome, " / ", nm)
      # Esta tabela preserva todas as colunas, valores e direcao originais.
      write.csv(selecionada, file.path(saida, paste0("Contraste_", nome, "_", nm, ".csv")),
                row.names = FALSE)
      # Metadados apenas para desenhar; o p e copiado sem reajuste.
      selecionada$characteristic <- nm
      if (!"wave" %in% names(selecionada)) selecionada$wave <- NA_character_
      selecionada$wave <- as.character(selecionada$wave)
      selecionada$p_adjusted <- selecionada$p.value
      selecionada$context <- resultado$context
      selecionada
    }))
  }
